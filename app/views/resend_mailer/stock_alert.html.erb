<%
  copy = {
    "es" => {
      "immediate" => { title: "Stock bajo", intro: "Estos productos de %{company} llegaron a su mínimo:" },
      "daily" => { title: "Resumen de stock bajo", intro: "Estos productos de %{company} siguen en o bajo su mínimo:" },
      stock: "Existencia", minimum: "Mínimo", action: "Abrir inventario", hello: "Hola"
    },
    "en" => {
      "immediate" => { title: "Low stock", intro: "These products at %{company} reached their minimum:" },
      "daily" => { title: "Low stock summary", intro: "These products at %{company} are still at or below their minimum:" },
      stock: "On hand", minimum: "Minimum", action: "Open inventory", hello: "Hi"
    }
  }
  lang = copy.key?(locale.to_s) ? locale.to_s : "es"
  texts = copy.fetch(lang)
  heading = texts.fetch(kind)
  inventory_url = "#{ENV.fetch("FRONTEND_URL", "http://localhost:4200").chomp("/")}/#{lang}/inventario"
  quantity = ->(value) { value = value.to_d; (value == value.round ? value.to_i : value.to_f).to_s }
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" /><title><%= heading[:title] %></title></head>
<body style="margin:0; padding:24px 16px; background-color:#f0f2f5; font-family:'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:16px; padding:32px;">
        <tr><td style="font-size:22px; font-weight:700; color:#141414; padding-bottom:12px;"><%= heading[:title] %> · <%= company_name %></td></tr>
        <tr><td style="font-size:15px; line-height:1.6; color:#4a4f55; padding-bottom:16px;"><%= texts[:hello] %> <%= user.first_name %>: <%= format(heading[:intro], company: company_name) %></td></tr>
        <tr><td style="padding-bottom:24px;">
          <table role="presentation" width="100%" cellpadding="6" cellspacing="0" border="0" style="font-size:14px; color:#141414; border-collapse:collapse;">
            <tr style="color:#4a4f55; text-align:left;"><th align="left"></th><th align="right"><%= texts[:stock] %></th><th align="right"><%= texts[:minimum] %></th></tr>
            <% products.each do |product| %>
              <tr style="border-top:1px solid #e5e7eb;">
                <td><%= product.name %></td>
                <td align="right"><strong><%= quantity.call(product.stock) %></strong></td>
                <td align="right"><%= quantity.call(product.min_stock) %></td>
              </tr>
            <% end %>
          </table>
        </td></tr>
        <tr><td><a href="<%= inventory_url %>" style="display:inline-block; background:#ff5a1f; color:#141414; font-weight:700; text-decoration:none; padding:14px 28px; border-radius:6px;"><%= texts[:action] %></a></td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
