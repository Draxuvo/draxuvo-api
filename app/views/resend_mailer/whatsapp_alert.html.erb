<%
  lang = %w[es en].include?(locale.to_s) ? locale.to_s : "es"
  title = I18n.t("whatsapp_admin.mail.subject", locale: lang)
  target_label = I18n.t("whatsapp_admin.targets.#{target}", locale: lang)
  message = if problem == "connection"
    I18n.t("whatsapp_admin.mail.connection", detail: detail, locale: lang)
  else
    I18n.t("whatsapp_admin.mail.template", target: target_label, detail: detail, locale: lang)
  end
  since_text = I18n.t("whatsapp_admin.mail.since", time: since.in_time_zone("America/Mexico_City").strftime("%d/%m/%Y %H:%M"), locale: lang)
  panel_url = "#{ENV.fetch("FRONTEND_URL", "http://localhost:4200").chomp("/")}/#{lang}/whatsapp"
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" /><title><%= title %></title></head>
<body style="margin:0; padding:24px 16px; background-color:#f0f2f5; font-family:'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:16px; padding:32px;">
        <tr><td style="font-size:22px; font-weight:700; color:#141414; padding-bottom:12px;"><%= title %></td></tr>
        <tr><td style="font-size:15px; line-height:1.6; color:#4a4f55; padding-bottom:8px;"><%= user.first_name %>: <%= message %></td></tr>
        <tr><td style="font-size:14px; line-height:1.6; color:#4a4f55; padding-bottom:24px;"><%= since_text %></td></tr>
        <tr><td><a href="<%= panel_url %>" style="display:inline-block; background:#ff5a1f; color:#141414; font-weight:700; text-decoration:none; padding:14px 28px; border-radius:6px;"><%= I18n.t("whatsapp_admin.mail.open", locale: lang) %></a></td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
