<%
  panel_url = "#{ENV.fetch("FRONTEND_URL", "http://localhost:4200").split(",").first.strip.chomp("/")}/es/terminales"
  title = "Tu conexión con #{provider_name} necesita atención"
  body = "La conexión de #{company_name} con #{provider_name} dejó de funcionar: #{reason_text} Mientras tanto, las terminales de #{provider_name} solo se pueden usar para registrar pagos a mano. Vuelve a conectar la cuenta desde Terminales."
%>
<!DOCTYPE html>
<html lang="es">
<head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" /><title><%= title %></title></head>
<body style="margin:0; padding:24px 16px; background-color:#f0f2f5; font-family:'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background:#ffffff; border-radius:16px; padding:32px;">
        <tr><td style="font-size:22px; font-weight:700; color:#141414; padding-bottom:12px;"><%= title %></td></tr>
        <tr><td style="font-size:15px; line-height:1.6; color:#4a4f55; padding-bottom:24px;">Hola <%= user.first_name %>: <%= body %></td></tr>
        <tr><td><a href="<%= panel_url %>" style="display:inline-block; background:#ff5a1f; color:#141414; font-weight:700; text-decoration:none; padding:14px 28px; border-radius:6px;">Ir a Terminales</a></td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
