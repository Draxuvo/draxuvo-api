# Copia este archivo a .env (ignorado por git) y llena los valores locales.

# JWT y CORS
SECRET_KEY_BASE=
# Panel (ui): destino de los enlaces de correo y origen CORS. En producción: https://app.draxuvo.com
FRONTEND_URL=http://localhost:4200
# Sitio público (web): origen CORS. En producción: https://draxuvo.com
FRONTEND_URL_UI=http://localhost:4300

# Solo producción (render.yaml). Sin ellas la API no arranca (config/initializers/required_env.rb):
# DATABASE_URL, APP_HOST=api.draxuvo.com, ALLOWED_HOSTS=api.draxuvo.com, RESEND_API_KEY,
# RESEND_FROM_EMAIL, STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET. Lista completa y responsables:
# specs/012-deploy-produccion/contracts/env-inventory.md del workspace.

# Base de datos de desarrollo (config/database.yml). En producción se usa DATABASE_URL.
DATABASE_USERNAME=
DATABASE_PASSWORD=
# DATABASE_HOST=localhost

# Contraseña del super admin que crean los seeds. Obligatoria al sembrar en producción (no al arrancar);
# en desarrollo, si falta, se usa un valor local por defecto.
SUPER_ADMIN_PASSWORD=

# Correo transaccional (opcional en local)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Stripe (opcional en local)
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# Tope de registros por hora y por IP (5 por defecto). Solo súbelo en CI de pruebas e2e.
# REGISTRATION_RATE_LIMIT=5

# Versión mínima de la app móvil por plataforma (semver). Si la instalada es menor, la app pide actualizar.
# MIN_APP_VERSION_IOS=0.0.0
# MIN_APP_VERSION_ANDROID=0.0.0
